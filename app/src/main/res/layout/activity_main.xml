<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA"
>

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 首页：权限 + 功能说明 -->
        <LinearLayout
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="闲鱼定时助手"
                    android:textColor="#111827"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="闲鱼本地任务 · 视频任务 · 小游戏任务"
                    android:textColor="#7A8190"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/runtime_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:clickable="false"
                    android:focusable="false"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="运行状态"
                            android:textColor="#374151"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/runtime_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_idle"
                            android:paddingStart="11dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="11dp"
                            android:paddingBottom="5dp"
                            android:text="待执行"
                            android:textColor="#166534"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_detail_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:text="任务未运行。点击下方执行按钮后，这里会显示当前执行状态和日志提示。"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="权限状态"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/root_permission_card"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_permission_denied"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <TextView
                            android:id="@+id/root_permission_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROOT"
                            android:textColor="#4B5563"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/root_permission_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="检测中"
                            android:textColor="#4B5563"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/root_permission_hint_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="KernelSU 超级用户权限"
                            android:textColor="#6B7280"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/alarm_permission_card"
                        android:layout_width="0dp"
                        android:layout_height="142dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_permission_denied"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="闹钟"
                            android:textColor="#4B5563"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/alarm_permission_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="未开启"
                            android:textColor="#4B5563"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/alarm_permission_hint_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="每日定时需要精确闹钟权限"
                            android:textColor="#6B7280"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="功能说明"
                        android:textColor="#2F6FED"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="5dp"
                        android:text="• 学习真人：只学习单次手势风格，不学习完整任务流程；记录点击微小偏移、按压时长、滑动抖动、弧度、距离和速度。\n• 自动执行：任务逻辑仍由程序自己判断；点击位置会在目标安全范围附近小幅变化，滑动会复用已学习的距离/曲线/速度，不固定在同一像素。\n• 记录：按日期查看已验证完成的任务与可确认的闲鱼币收益。\n• 自动化：一键擦亮、本地、视频、跳转四类任务独立运行和每日定时。\n• 日志：查看完整运行过程和故障信息。"
                        android:textColor="#4B5563"
                        android:textSize="14sp" />
                </LinearLayout>


            </LinearLayout>
        </LinearLayout>

        <!-- 今日：当天已验证完成的任务 -->
        <ScrollView
            android:id="@+id/page_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="任务记录"
                            android:textColor="#111827"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/today_date_text"
                            android:layout_width="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="今天"
                            android:textColor="#7A8190"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/today_refresh_button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:minWidth="0dp"
                        android:backgroundTint="#E9EEF8"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="刷新"
                        android:textColor="#2F6FED"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/today_summary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="今日完成 0 个任务 · 闲鱼币 +0"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/today_completed_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="6dp"
                        android:text="今天还没有已验证完成的任务。

历史记录会按日期保存在本机。"
                        android:textColor="#4B5563"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="按日期保存已验证 SUCCESS 的任务；失败、未验证和人工中止不计入。闲鱼币仅统计程序能够明确识别到奖励数值的记录。"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 自动化：固定单屏紧凑布局，不滚动 -->
        <LinearLayout
            android:id="@+id/page_automation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动化"
                android:textColor="#111827"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="定时按擦亮 → 本地 → 视频 → 跳转执行已开启任务"
                android:textColor="#7A8190"
                android:textSize="11sp" />

            <!-- 定时：压缩为一行状态 + 两个小按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每日定时"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/schedule_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:text="每日任务：未启用"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/schedule_button"
                    android:layout_width="76dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:backgroundTint="#E9EEF8"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="设置时间"
                    android:textColor="#2F6FED"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/cancel_button"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:backgroundTint="#F3F4F6"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="取消定时"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 四类任务等高分布，占满中间可用空间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一键擦亮" android:textColor="#374151" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="进入“我发布的”，自动点击一次顶部一键擦亮" android:textColor="#9CA3AF" android:textSize="10sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_polish_task" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="一键擦亮开关" />
                </LinearLayout>

                <Space android:layout_width="1dp" android:layout_height="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="闲鱼本地任务" android:textColor="#374151" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="签到、浏览、领取、商城优惠券等闲鱼内任务" android:textColor="#9CA3AF" android:textSize="10sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_local_task" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="闲鱼本地任务开关" />
                </LinearLayout>

                <Space android:layout_width="1dp" android:layout_height="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="视频任务" android:textColor="#374151" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="执行视频浏览与视频奖励任务" android:textColor="#9CA3AF" android:textSize="10sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_video_task" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="视频任务开关" />
                </LinearLayout>

                <Space android:layout_width="1dp" android:layout_height="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="小游戏任务" android:textColor="#374151" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="支付宝、淘宝、农场、闪购等跨页面任务" android:textColor="#9CA3AF" android:textSize="10sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_game_task" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="小游戏任务开关" />
                </LinearLayout>
            </LinearLayout>

            <!-- 执行区固定在底部导航上方，不参与滚动 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="执行任务" android:textColor="#374151" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="按当前已开启分类立即执行" android:textColor="#9CA3AF" android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/execute_task_button"
                    android:layout_width="104dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:backgroundTint="#2F6FED"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="立即执行"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 日志：固定页面，终端内部独立滚动 -->
        <LinearLayout
            android:id="@+id/page_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行日志"
                android:textColor="#111827"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="分类任务运行过程与故障信息"
                android:textColor="#7A8190"
                android:textSize="13sp" />

            <!-- 运行终端 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_weight="0"
                android:minHeight="0dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="运行终端"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_terminal_log"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/log_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:text="暂无日志"
                        android:textColor="#D5D7DB"
                        android:textIsSelectable="true"
                        android:textSize="10sp" />
                </ScrollView>
            </LinearLayout>

            <!-- 数据路径 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="数据路径"
                            android:textColor="#374151"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/data_path_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="点击查看日志和任务记录保存位置"
                            android:textColor="#6B7280"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/show_path_button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:backgroundTint="#E9EEF8"
                        android:text="查看路径"
                        android:textColor="#2F6FED"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 日志操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/log_button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E9EEF8"
                        android:text="刷新日志"
                        android:textColor="#2F6FED"
                        android:textSize="11sp" />

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/copy_all_log_button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#EAF7EE"
                        android:text="复制全部"
                        android:textColor="#166534"
                        android:textSize="11sp" />

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/clear_log_button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FDECEC"
                        android:text="清空日志"
                        android:textColor="#B42318"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="显示最近 120 行 · “复制全部”复制完整日志"
                    android:textColor="#9CA3AF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- V4.26：仿用户示例的悬浮式深色底部导航 -->
    <LinearLayout
        android:id="@+id/bottom_nav_shell"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_nav_shell"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="首页"
                android:textColor="#AEB4BF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_today_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_nav_today" />

            <TextView
                android:id="@+id/nav_today_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="记录"
                android:textColor="#AEB4BF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_automation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_automation_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_nav_automation" />

            <TextView
                android:id="@+id/nav_automation_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="自动化"
                android:textColor="#AEB4BF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_logs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_logs_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_nav_logs" />

            <TextView
                android:id="@+id/nav_logs_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="日志"
                android:textColor="#AEB4BF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
